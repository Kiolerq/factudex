# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings → API). Nunca subas .env.local al repo.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Lectura de comprobantes con IA (solo servidor, nunca NEXT_PUBLIC_). Ver docs/lectura-ia.md
# ANTHROPIC_API_KEY=
# OCR_MODELO=claude-opus-5-5   # opcional

# Google Drive para los comprobantes (solo servidor). Ver docs/google-drive.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=   # Supabase → Project Settings → API Keys → service_role (secreta)
